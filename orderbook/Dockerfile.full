# syntax=docker/dockerfile:1
#
# Self-contained (multi-stage) image for the Haveno orderbook observer node: builds the
# distribution inside a JDK 21 container, then packages it exactly like orderbook/Dockerfile.
#
# Build from the repository root:
#   docker build -f orderbook/Dockerfile.full -t haveno-orderbook:latest .

########################  build stage  ########################
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=haveno-gradle,target=/root/.gradle \
    ./gradlew --no-daemon :orderbook:installDist -x test

########################  runtime stage  ########################
FROM eclipse-temurin:21-jre

RUN groupadd -r haveno && useradd -r -g haveno -m -d /home/haveno haveno \
    && mkdir -p /data && chown -R haveno:haveno /data

WORKDIR /app
COPY --from=build /src/orderbook/build/app/ /app/
COPY orderbook/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /app/bin/haveno-orderbook

ENV HAVENO_REST_HOST=0.0.0.0 \
    HAVENO_REST_PORT=8080 \
    HAVENO_BASE_CURRENCY_NETWORK=XMR_MAINNET \
    HAVENO_APP_DATA_DIR=/data \
    JAVA_OPTS="-XX:MaxRAM=2g"

EXPOSE 8080
VOLUME ["/data"]
USER haveno

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
